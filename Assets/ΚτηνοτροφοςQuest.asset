  m_Script: {fileID: 11500000, guid: c480431232a499a4fbfc8a88d90d3a13, type: 3}
  m_Name: "\u039A\u03C4\u03B7\u03BD\u03BF\u03C4\u03C1\u03BF\u03C6\u03BF\u03C2Quest"
  m_EditorClassIdentifier: 
  questName: "\u03A4\u03C1\u03BF\u03C6\u03AE \u03B3\u03B9\u03B1 \u0396\u03CE\u03B1"
  description: "\u039A\u03B1\u03BB\u03AD \u03BC\u03BF\u03C5 \u03C4\u03B1\u03BE\u03B9\u03B4\u03B9\u03CE\u03C4\u03B7,
    \u03BC\u03B9\u03B1 \u03C7\u03AC\u03C1\u03B7 \u03C3\u03BF\u03C5 \u03B6\u03B7\u03C4\u03CE,
    \u03B1\u03BD \u03B4\u03B5\u03BD \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03BA\u03CC\u03C0\u03BF\u03C2\u2026 \u0397 \u03C4\u03C1\u03BF\u03C6\u03AE \u03B3\u03B9\u03B1
    \u03C4\u03B1 \u03B6\u03CE\u03B1 \u03BC\u03BF\u03C5 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03BD\u03B5\u03B9
    \u03BA\u03B1\u03B9 \u03B4\u03CD\u03C3\u03BA\u03BF\u03BB\u03B5\u03C2 \u03BC\u03AD\u03C1\u03B5\u03C2
    \u03AD\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9. \u039F \u03C6\u03AF\u03BB\u03BF\u03C2
    \u03BC\u03BF\u03C5, \u03BF \u039B\u03B5\u03C5\u03C4\u03AD\u03C1\u03B7\u03C2,
    \u03B6\u03B5\u03B9 \u03B2\u03CC\u03C1\u03B5\u03B9\u03B1, \u03BA\u03BF\u03BD\u03C4\u03AC
    \u03C3\u03C4\u03B7 \u03B3\u03AD\u03C6\u03C5\u03C1\u03B1 \u03C4\u03BF\u03C5 \u03BA\u03AC\u03C3\u03C4\u03C1\u03BF\u03C5.
    \u0388\u03C7\u03B5\u03B9 \u03C0\u03AC\u03BD\u03C4\u03B1 \u03C0\u03C1\u03BF\u03BC\u03AE\u03B8\u03B5\u03B9\u03B5\u03C2
    \u03BA\u03B1\u03B9 \u03BC\u2019 \u03AD\u03C7\u03B5\u03B9 \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03B5\u03B9
    \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF \u03C0\u03B1\u03C1\u03B5\u03BB\u03B8\u03CC\u03BD.
    \u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03CE \u03BD\u03B1 \u03C6\u03CD\u03B3\u03C9
    \u03C4\u03CE\u03C1\u03B1 \u03B1\u03C0\u2019 \u03C4\u03BF \u03BC\u03B1\u03BD\u03C4\u03C1\u03AF
    \u2013 \u03C4\u03B1 \u03B6\u03CE\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B4\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03CE\u03C1\u03B1
    \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B9\u03B3\u03BC\u03AE. \u0391\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2
    \u03BD\u03B1 \u03C0\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03BF\u03C5
    \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9\u03C2 \u03C4\u03BF \u03BC\u03AE\u03BD\u03C5\u03BC\u03AC
    \u03BC\u03BF\u03C5\u2026 \u03C0\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03C9\u03C2
    \u03BF \u039C\u03AC\u03C1\u03BA\u03BF\u03C2 \u03AD\u03C7\u03B5\u03B9 \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7
    \u03B1\u03C0\u03CC \u03C4\u03C1\u03BF\u03C6\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B1
    \u03B6\u03CE\u03B1. \u039A\u03B9 \u03B1\u03BD \u03C4\u03BF \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
    \u03B1\u03C5\u03C4\u03CC \u03B3\u03B9\u03B1 \u03BC\u03AD\u03BD\u03B1\u2026 \u03B8\u03B1
    \u03C3\u03B5 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03C9 \u03BA\u03B1\u03BB\u03AC.
    \u03A4\u03BF \u03C5\u03C0\u03CC\u03C3\u03C7\u03BF\u03BC\u03B1\u03B9"
  completionDescription: "\u039F \u039C\u03AC\u03C1\u03BA\u03BF\u03C2 \u03AD\u03C7\u03B5\u03B9
    \u03C0\u03C1\u03CC\u03B2\u03BB\u03B7\u03BC\u03B1, \u03B5; \u03A4\u03BF\u03C5
    \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03BD\u03B5\u03B9 \u03B7 \u03C4\u03C1\u03BF\u03C6\u03AE\u2026
    \u039D\u03B1\u03B9, \u03C4\u03BF\u03BD \u03BE\u03AD\u03C1\u03C9, \u03B4\u03B5\u03BD
    \u03B6\u03B7\u03C4\u03AC\u03B5\u03B9 \u03B2\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1
    \u03B5\u03CD\u03BA\u03BF\u03BB\u03B1. \u03A0\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03BD\u03B1
    \u03BC\u03B7 \u03BD\u03BF\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u2013 \u03B8\u03B1
    \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B5\u03AF\u03BB\u03C9 \u03CC,\u03C4\u03B9 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03C0\u03C1\u03B9\u03BD \u03C0\u03AD\u03C3\u03B5\u03B9 \u03BF \u03AE\u03BB\u03B9\u03BF\u03C2.
    \u0395\u03AF\u03C3\u03B1\u03B9 \u03BA\u03B1\u03BB\u03CC\u03C2 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03C2
    \u03C0\u03BF\u03C5 \u03BC\u03C0\u03AE\u03BA\u03B5\u03C2 \u03C3\u03C4\u03BF\u03BD
    \u03BA\u03CC\u03C0\u03BF \u03BD\u03B1 \u03AD\u03C1\u03B8\u03B5\u03B9\u03C2\u2026
    \u0391\u03BD \u03AE\u03C4\u03B1\u03BD \u03CC\u03BB\u03BF\u03B9 \u03C3\u03B1\u03BD
    \u03B5\u03C3\u03AD\u03BD\u03B1, \u03BF \u03BA\u03CC\u03C3\u03BC\u03BF\u03C2 \u03BC\u03B1\u03C2
    \u03B8\u03B1 \u03AE\u03C4\u03B1\u03BD \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C2"
  isAccepted: 0
  isCompleted: 0
