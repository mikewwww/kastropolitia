  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 595511936}
  dialogueLine: "\u038C,\u03C4\u03B9 \u03B2\u03BB\u03AD\u03C0\u03B5\u03B9\u03C2 \u03B5\u03B4\u03CE
    \u03AD\u03C7\u03B5\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1. \u0386\u03BB\u03BB\u03BF
    \u03C6\u03B1\u03B3\u03CE\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7,
    \u03AC\u03BB\u03BB\u03BF \u03C3\u03C4\u03B7\u03BD \u03B3\u03B9\u03BF\u03C1\u03C4\u03AE.
    \u03A4\u03BF \u03BC\u03CC\u03BD\u03BF \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C0\u03BF\u03C5\u03BB\u03AC\u03C9\u2026
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03C3\u03B9\u03C9\u03C0\u03AE. \u0391\u03C5\u03C4\u03AE
    \u03C4\u03B7 \u03C6\u03C5\u03BB\u03AC\u03C9 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
    \u03B5\u03B1\u03C5\u03C4\u03CC \u03BC\u03BF\u03C5."
  displayTime: 3
  maxDisplayDistance: 5
