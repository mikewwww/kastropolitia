  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 1433604955}
  dialogueLine: "\u03A4\u03BF \u03BC\u03BF\u03C3\u03C7\u03AC\u03C1\u03B9 \u03B1\u03C5\u03C4\u03CC
    \u03AE\u03C4\u03B1\u03BD \u03C4\u03CC\u03C3\u03BF \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC
    \u03C0\u03BF\u03C5 \u03BC\u03BF\u03C5 \u03AD\u03C3\u03C0\u03B1\u03C3\u03B5 \u03C4\u03BF
    \u03BC\u03B1\u03C7\u03B1\u03AF\u03C1\u03B9\u2026 \u03C4\u03C1\u03B5\u03B9\u03C2
    \u03C6\u03BF\u03C1\u03AD\u03C2. \u0395\u03AF\u03C7\u03B1 \u03C3\u03C7\u03B5\u03B4\u03CC\u03BD
    \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03C3\u03B5\u03B9 \u03BD\u03B1 \u03C4\u03BF\u03C5
    \u03B2\u03B3\u03AC\u03BB\u03C9 \u03BA\u03B1\u03B9 \u03CC\u03BD\u03BF\u03BC\u03B1...
    \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03BF \u03B1\u03C6\u03AE\u03C3\u03C9 \u03BD\u03B1
    \u03B6\u03AE\u03C3\u03B5\u03B9. \u0391\u03BB\u03BB\u03AC \u03BC\u03B5\u03C4\u03AC
    \u03B8\u03C5\u03BC\u03AE\u03B8\u03B7\u03BA\u03B1 \u03C0\u03C9\u03C2 \u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
    \u03B8\u03AD\u03BB\u03B5\u03B9 \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2..."
  displayTime: 3
  maxDisplayDistance: 5
