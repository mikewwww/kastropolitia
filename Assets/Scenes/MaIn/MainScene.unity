  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 458631827}
  dialogueLine: " \u0391\u03C5\u03C4\u03AE \u03B7 \u03C1\u03AF\u03B3\u03B1\u03BD\u03B7
    \u03AE\u03C1\u03B8\u03B5 \u03B1\u03C0\u2019 \u03C4\u03BF \u03B1\u03C0\u03AD\u03BD\u03B1\u03BD\u03C4\u03B9
    \u03B2\u03BF\u03C5\u03BD\u03CC. \u039C\u03AC\u03B6\u03B5\u03C5\u03B5 \u03BF \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1\u03C2
    \u03BC\u03BF\u03C5 \u03B5\u03BA\u03B5\u03AF, \u03C0\u03C1\u03B9\u03BD \u03C4\u03BF\u03BD
    \u03C6\u03AC\u03BD\u03B5 \u03BF\u03B9 \u03B1\u03C1\u03BA\u03BF\u03CD\u03B4\u03B5\u03C2.
    \u03A4\u03BF \u03C0\u03B9\u03C0\u03AD\u03C1\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC \u03C6\u03AD\u03C4\u03BF\u03C2 \u03AE \u03B5\u03B3\u03CE
    \u03B3\u03AD\u03C1\u03B1\u03C3\u03B1. \u039D\u03B1 \u03C0\u03C1\u03BF\u03C3\u03AD\u03C7\u03B5\u03B9\u03C2
    \u03C4\u03B9 \u03B1\u03B3\u03BF\u03C1\u03AC\u03B6\u03B5\u03B9\u03C2... \u0394\u03B5\u03BD
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03BB\u03B1 \u03B3\u03B9\u03B1 \u03C6\u03B1\u03B3\u03B7\u03C4\u03CC!"
