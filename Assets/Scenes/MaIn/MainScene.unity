  dialogueLine: "\u03C0\u03AC\u03BB\u03B5\u03C8\u03B1 \u03BC\u03B5 \u03BA\u03B1\u03BB\u03B1\u03BC\u03AC\u03C1\u03B9
    \u03C0\u03B9\u03BF \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF \u03B1\u03C0\u2019 \u03C4\u03BF
    \u03BC\u03B1\u03B3\u03B1\u03B6\u03AF \u03BC\u03BF\u03C5! \u039A\u03B9 \u03B5\u03C3\u03CD
