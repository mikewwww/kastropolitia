--- !u!114 &1330394987
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1330394982}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4694f28193e7464fbcc408fbfad78fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 1824007275}
  dialogueLine: "\u0391\u03BD \u03AE\u03C1\u03B8\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C3\u03C0\u03B1\u03B8\u03AF,
    \u03AD\u03C7\u03B5\u03B9\u03C2 \u03C4\u03CD\u03C7\u03B7, \u03B1\u03BD \u03AE\u03C1\u03B8\u03B5\u03C2
    \u03B3\u03B9\u03B1 \u03BA\u03BF\u03C5\u03B2\u03AD\u03BD\u03C4\u03B1, \u03C6\u03AD\u03C1\u03B5
    \u03C0\u03C1\u03CE\u03C4\u03B1 \u03BC\u03B9\u03B1 \u03BC\u03C0\u03CD\u03C1\u03B1!
    \u038C,\u03C4\u03B9 \u03B2\u03BB\u03AD\u03C0\u03B5\u03B9\u03C2 \u03B5\u03B4\u03CE
    \u03C4\u03BF '\u03C7\u03C9 \u03C6\u03C4\u03B9\u03AC\u03BE\u03B5\u03B9 \u03BC\u03B5
    \u03C3\u03C6\u03C5\u03C1\u03AF, \u03B9\u03B4\u03C1\u03CE\u03C4\u03B1\u2026 \u03BA\u03B1\u03B9
    \u03BB\u03AF\u03B3\u03B5\u03C2 \u03BA\u03B1\u03C4\u03AC\u03C1\u03B5\u03C2 \u03CC\u03C4\u03B1\u03BD
    \u03C3\u03C4\u03C1\u03B1\u03B2\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF \u03BC\u03AD\u03C4\u03B1\u03BB\u03BB\u03BF.
    \u039A\u03B1\u03B9 \u03C0\u03C1\u03CC\u03C3\u03B5\u03C7\u03B5, \u03BC\u03B7 \u03BC\u03BF\u03C5
    \u03C0\u03B5\u03B9\u03C2 \u03C0\u03C9\u03C2 '\u03CC\u03BB\u03B1 \u03C4\u03B1
    \u03C3\u03C0\u03B1\u03B8\u03B9\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AF\u03B4\u03B9\u03B1',
    \u03B8\u03B1 \u03B4\u03B5\u03B9\u03C2 \u03C4\u03BF \u03B1\u03BC\u03CC\u03BD\u03B9
    \u03BC\u03BF\u03C5 \u03B1\u03C0\u03CC \u03C0\u03BF\u03BB\u03CD \u03BA\u03BF\u03BD\u03C4\u03AC.
    \u039A\u03B1\u03B9 \u03C0\u03AF\u03C3\u03C4\u03B5\u03C8\u03AD \u03BC\u03B5\u2026
    \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03CC\u03C3\u03BF \u03AC\u03BD\u03B5\u03C4\u03BF
    \u03CC\u03C3\u03BF \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9!"
  displayTime: 3
  maxDisplayDistance: 5
