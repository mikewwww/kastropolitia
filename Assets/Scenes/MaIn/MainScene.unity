--- !u!114 &864023397
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 864023392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4694f28193e7464fbcc408fbfad78fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 73297913}
  dialogueLine: "\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u03BA\u03C1\u03B1\u03C3\u03AF
    \u03C4\u03BF \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03C3\u03B1 \u03B3\u03B9\u03B1
    \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C4\u03B9\u03B3\u03BC\u03AD\u03C2.
    \u03A4\u03B5\u03BB\u03B9\u03BA\u03AC, \u03B4\u03B5\u03BD \u03AE\u03C1\u03B8\u03B1\u03BD
    \u03C0\u03BF\u03C4\u03AD. \u039F \u03C0\u03B1\u03C0\u03C0\u03BF\u03CD\u03C2 \u03BC\u03BF\u03C5
    \u03AD\u03BB\u03B5\u03B3\u03B5 \u201C\u03B7 \u03C6\u03B1\u03BA\u03AE \u03C3\u03B5
    \u03BA\u03C1\u03B1\u03C4\u03AC\u03B5\u03B9 \u03B6\u03C9\u03BD\u03C4\u03B1\u03BD\u03CC,
    \u03B1\u03BB\u03BB\u03AC \u03C4\u03BF \u03C3\u03BA\u03CC\u03C1\u03B4\u03BF \u03C3\u03BF\u03C5
    \u03B8\u03C5\u03BC\u03AF\u03B6\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03B5\u03AF\u03C3\u03B1\u03B9
    \u03B1\u03BA\u03CC\u03BC\u03B1 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03C2.\u201D
    \u039C\u03B7\u03BD \u03C5\u03C0\u03BF\u03C4\u03B9\u03BC\u03AC\u03C2 \u03C4\u03BF
    \u03B1\u03BB\u03AC\u03C4\u03B9. \u03A0\u03B9\u03BF \u03C0\u03BF\u03BB\u03BB\u03BF\u03AF
    \u03C4\u03C3\u03B1\u03BA\u03CE\u03B8\u03B7\u03BA\u03B1\u03BD \u03B3\u03B9\u2019
    \u03B1\u03C5\u03C4\u03CC \u03B1\u03C0\u2019 \u03CC,\u03C4\u03B9 \u03B3\u03B9\u03B1
    \u03C4\u03BF \u03C7\u03C1\u03C5\u03C3\u03AC\u03C6\u03B9."
  displayTime: 3
  maxDisplayDistance: 5
